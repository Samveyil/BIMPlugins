<Window x:Class="BIMPlugins.Families.WPF.FamilyCheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:BIMPlugins.Windows.Behaviors;assembly=BIMPlugins.Windows"
        xmlns:classes="clr-namespace:BIMPlugins.Families.Classes"
        xmlns:converters="clr-namespace:BIMPlugins.Windows.Converters;assembly=BIMPlugins.Windows"
        xmlns:local="clr-namespace:BIMPlugins.Families.WPF"
        d:DataContext="{d:DesignInstance local:FamilyCheckerVM}"
        mc:Ignorable="d"
        Title="Настройка параметров" Height="900" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#f88518" SecondaryColor="#FF0052A5" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <materialDesign:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <materialDesign:BooleanToVisibilityConverter x:Key="InvertBoolToVis" TrueValue="Collapsed" FalseValue="Visible"/>
            <materialDesign:NullableToVisibilityConverter x:Key="NullToVis" NullValue="Visible" NotNullValue="Collapsed"/>
            <converters:IntToVisibilityConverter x:Key="IntToVis" />

            <CollectionViewSource x:Key="cvsItems" Source="{Binding Parameters}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <Border BorderBrush="#f88518" BorderThickness="1" Padding="0" Margin="5">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Parameter"/>
                        <ColumnDefinition SharedSizeGroup="Mode"/>
                        <ColumnDefinition SharedSizeGroup="Value"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Параметр" Margin="5" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center"/>

                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1 0">
                        <TextBlock Text="Режим" Margin="15 5" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="2" Text="Значение" Margin="5" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Source={StaticResource cvsItems}}" Padding="0" MinHeight="570" MaxHeight="570"
                         SelectionMode="Extended" behaviors:ListBoxBehavior.SelectedItems="{Binding SelectedItems}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="0 5" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <ContentPresenter Grid.Row="0" Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"/>

                                                    <ItemsPresenter Grid.Row="1" Margin="0"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0 1" BorderBrush="#B5B5B5" Padding="0" Background="#E1E1E1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Margin="10 5 0 5" VerticalAlignment="Center"/>
                                            <Button Width="18" Height="18" Padding="0" Margin="5 0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveParameterGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                    CommandParameter="{Binding Name}"
                                                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Удалить">
                                                <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18" />
                                            </Button>
                                        </StackPanel>

                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type classes:ParameterItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MinWidth="190" MaxWidth="330" SharedSizeGroup="Parameter"/>
                                    <ColumnDefinition Width="auto" SharedSizeGroup="Mode"/>
                                    <ColumnDefinition Width="auto" SharedSizeGroup="Value"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="5 0 0 0"
                                              Command="{Binding DataContext.CheckParameterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding }"/>
                                    <TextBlock Text="{Binding Name}" Margin="5 0" VerticalAlignment="Center"/>

                                    <Button Width="18" Height="18" Padding="0" Margin="5 0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Удалить">
                                        <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18" />
                                    </Button>
                                </StackPanel>

                                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1 0" Margin="0 -5">
                                    <ComboBox Grid.Column="1" Margin="10 0" SelectedIndex="{Binding ModeIndex}" HorizontalContentAlignment="Center"
                                              materialDesign:ComboBoxAssist.ShowSelectedItem="False"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="5 1" Width="100" >
                                        <ComboBoxItem Content="Диапазон"/>
                                        <ComboBoxItem Content="Фикс"/>
                                        <ComboBoxItem Content="Список"/>
                                        <ComboBoxItem Content="Таблица"/>
                                    </ComboBox>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ModeIndex, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsYesNo, Converter={StaticResource InvertBoolToVis}}">
                                            <TextBlock Text="от" Margin="10 0 5 0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MinValue}" Width="60" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Padding="5 1" TextAlignment="Center" />

                                            <TextBlock Text="до" Margin="5 0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MaxValue}" Width="60" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Padding="5 1" TextAlignment="Center"/>
                                            
                                            <TextBlock Text="Шаг:" Margin="15 0 5 0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Step}" Width="60" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Padding="5 1" TextAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsYesNo, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Да/Нет" Margin="10 0 5 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Visibility="{Binding ModeIndex, Converter={StaticResource IntToVis}, ConverterParameter=1}">
                                        <TextBlock Text="Да - 1; Нет - 0" Margin="10 0 0 0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsYesNo, Converter={StaticResource BoolToVis}}"/>

                                        <TextBox Text="{Binding FixedValue}" Width="60" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="5 1"
                                                 materialDesign:HintAssist.IsFloating="False" Margin="10 0" TextAlignment="Center" ToolTip="Значение параметра"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Visibility="{Binding ModeIndex, Converter={StaticResource IntToVis}, ConverterParameter=2}">
                                        <TextBox Text="{Binding Values}" Width="266" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="5 1"
                                                 materialDesign:HintAssist.IsFloating="False" Margin="10 0" ToolTip="Значения параметов"
                                                 Visibility="{Binding IsYesNo, Converter={StaticResource InvertBoolToVis}}"/>

                                        <TextBlock Text="Не применимо!" Margin="10 0" Foreground="Red"
                                                   Visibility="{Binding IsYesNo, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Visibility="{Binding ModeIndex, Converter={StaticResource IntToVis}, ConverterParameter=3}">
                                        <TextBlock Text="Отсутствует в таблице!" Margin="10 0" Foreground="Red"
                                                   Visibility="{Binding FamilySizeTable, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GroupBox Padding="0" Margin="5">
            <GroupBox.Header>
                <TextBlock Text="Генерация тестов" FontWeight="SemiBold" />
            </GroupBox.Header>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Количество тестов:" Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TestsCount}" Width="60" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0 5"  Padding="5 1" TextAlignment="Center"/>

                    <Button Width="25" Height="25" Padding="0" Margin="15 0" Command="{Binding GenerateTestsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Создать тесты">
                        <materialDesign:PackIcon Kind="Sync" Width="25" Height="25" Foreground="Black"/>
                    </Button>
                </StackPanel>

                <Slider Minimum="1" Maximum="{Binding TestsCount}" Margin="5" TickFrequency="1" Value="{Binding TestIndex}"
                        Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}" IsEnabled="{Binding IsGenerated}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ValueChanged">
                            <i:InvokeCommandAction Command="{Binding UpdateCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Slider>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</Window>